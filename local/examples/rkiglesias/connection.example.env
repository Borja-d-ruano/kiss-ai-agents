# Copiar a un .env local (no commitear) y cargar: set -a && source .env && set +a
#
# Terminal A (carpeta rkiglesias):
#   python3 server/kiss_tool_gateway.py
#
# Terminal B (misma carpeta):
#   python3 run_rk.py "Busca pisos en Oviedo"

KISS_HTTP_TOOL_BASE_URL=http://127.0.0.1:9876
KISS_HTTP_TOOL_USER=demo
KISS_HTTP_TOOL_PASSWORD=demo

OPENAI_API_KEY=
KISS_OPENAI_CHAT_MODEL=gpt-4o-mini

KISS_GATEWAY_PORT=9876
KISS_GATEWAY_USER=demo
KISS_GATEWAY_PASSWORD=demo
# KISS_GATEWAY_DISABLE_AUTH=1

# --- Gateway → API SaaS / sitio comprador (iagestión vía API Next) ---
# Si defines KISS_SAAS_API_BASE_URL, el gateway deja los stubs demo y llama a la API real
# (mismos paths que rag-api mcp_providers/property_search). El token suele ser API_TOKEN del backend.
# KISS_SAAS_API_BASE_URL=https://rkcompradores.alt-94.dev
# KISS_SAAS_API_TOKEN=
# Opcional: header tipo X-API-Token en lugar de Bearer
# KISS_SAAS_USE_X_API_TOKEN=1

# Enlaces en JSON si la API no devuelve url (search / detalle)
KISS_RK_PUBLIC_BASE=https://rkcompradores.alt-94.dev
